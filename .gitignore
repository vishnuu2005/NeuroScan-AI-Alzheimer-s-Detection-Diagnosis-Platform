# Python virtual environments & caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/

# Environment variables (allow .env.example)
.env
.env.local
.env.*.local
!.env.example

# Byte-compiled / binary files
*.so
*.dylib
*.pyd

# Distribution / packaging
build/
dist/
.eggs/
*.egg

# Testing & Coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/

# IDE configurations
.vscode/
.idea/
*.swp
*.swo

# Data, model weights & caches
models/*.pth
torch_cache/
matplotlib_cache/
plots/
data/
data/**

# Uploads & Reports runtime files
static/uploads/*
!static/uploads/.gitkeep
static/reports/*
!static/reports/.gitkeep
chatbot/static/uploads/*
!chatbot/static/uploads/.gitkeep
chatbot/static/reports/*
!chatbot/static/reports/.gitkeep

# Database & Instances
instance/
*.db
*.sqlite
*.sqlite3

# OS files & logs
.DS_Store
Thumbs.db
*.log
