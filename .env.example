# =================================================================
# NeuroScan AI — Environment Configuration Blueprint
# Copy this file to .env and adjust variables as required.
# =================================================================

# Flask Application Settings
FLASK_APP=chatbot.app
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=neuroscan_dev_secret_key_change_in_production

# Database Configuration
# Default: SQLite file inside instance/ or project root
DATABASE_URL=sqlite:///neuroscan.db

# Groq LLM API Configuration
# Optional: If omitted or invalid, the assistant falls back to localized medical guidance
GROQ_API_KEY=your_groq_api_key_here
USE_GROQ=1
GROQ_MODEL=llama-3.3-70b-versatile

# Alzheimer MRI Inference Parameters
# Confidence threshold (0.0 - 1.0): below this, prediction returns 'Uncertain'
PREDICTION_THRESHOLD=0.30
IMAGE_SIZE=224

# Storage & Upload Configuration
UPLOAD_FOLDER=static/uploads
REPORTS_FOLDER=static/reports
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload limit
