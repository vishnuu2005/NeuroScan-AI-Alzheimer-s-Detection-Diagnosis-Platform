# NeuroScan AI - Environment Configuration Example
# Copy this template to .env and adjust values for your environment

# Flask Application Secret Key
FLASK_SECRET_KEY=neuroscan_dev_secret_replace_in_production_2026

# Groq LLM API Configuration
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
USE_GROQ=1

# Model & Inference Parameters
MODEL_PATH=models/resnet2d_alzheimers_best.pth
IMAGE_SIZE=224
PREDICTION_THRESHOLD=0.30

# Database URI (defaults to SQLite instance)
# SQLALCHEMY_DATABASE_URI=sqlite:///neuroscan.db

# Matplotlib cache directory
MPLCONFIGDIR=.matplotlib_cache
